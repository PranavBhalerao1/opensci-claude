# Claude on Amazon Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Web search for agents (web_search tool)
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

SUPABASE_URL=
DATABASE_URL=

E2B_API_KEY=
E2B_TEMPLATE=openscientist-cpu

# Cloud GPUs for run_gpu_jobs: modal (default) or colab (Google Colab through the `colab` CLI,
# Linux/macOS only; see docs/colab-gpu.md). The credentials file is the ADC JSON written by
# `gcloud auth application-default login`; keep it outside the repo (chmod 600).
# GPU_PROVIDER=colab
# COLAB_CREDENTIALS_FILE=/home/you/.openscientist/colab/credentials.json
# COLAB_MAX_SESSIONS=1

# Optional overrides
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# MODEL_REASONING=
# MODEL_STANDARD=
# MODEL_BULK=
# DATABASE_URL=sqlite:///./data/openscientist.db
# OPENALEX_API_KEY=
