OPENAI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Supabase project used for authentication (same project as frontend/.env.example).
# Required so the backend can verify a user's bearer token and derive their id.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only needed if your project still signs tokens with the legacy shared HS256
# secret ("JWT Secret" in Supabase project settings) instead of JWT signing keys.
# SUPABASE_JWT_SECRET=

# Postgres connection string for this Supabase project (Project Settings > Database
# > Connection string; use the "Session" pooler or a direct connection, not the
# "Transaction" pooler, which does not support the prepared statements SQLAlchemy
# uses). Defaults to a local SQLite file for offline development and tests.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Optional overrides
# MODEL_REASONING=gpt-6-astra
# MODEL_STANDARD=gpt-6-sol
# MODEL_BULK=gpt-6-luna
# DATABASE_URL=sqlite:///./data/openscientist.db
# OPENALEX_API_KEY=
