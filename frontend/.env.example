# FastAPI backend this frontend talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project used for authentication (Project Settings > API). The
# publishable key is safe to expose to the browser (it is not a secret); it only
# lets the client sign users in and read/write rows their own RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
